{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "taalroute-digibord",
  "compatibility_date": "2026-09-13",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/live/*"
    ]
  },
  "build": {
    "command": "npm run build"
  },
  "main": "worker/live.mjs",
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE_SESSIONS",
        "class_name": "LiveSession"
      }
    ]
  },
  "migrations": [
    {
      "tag": "zinnenbouwer-v1",
      "new_sqlite_classes": [
        "LiveSession"
      ]
    }
  ]
}
