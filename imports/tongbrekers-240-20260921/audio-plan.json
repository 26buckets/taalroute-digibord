    },
    {
      "id": "TR-TONGUE-131",
      "text": "De plakker plakt platte plaatjes op een plakkerige plastic plaat.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-131.mp3",
      "sha256": "935c983198063385fc314993b75b705531c8efa304c3d8f7f565a36a239c4d78"
    },
    {
      "id": "TR-TONGUE-132",
      "text": "Trage trams trillen terwijl drie treinen langs het station razen.",
