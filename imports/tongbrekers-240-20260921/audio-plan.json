      "src": "assets/audio/tongbrekers/tr-tongue-133.mp3",
      "sha256": "764f0374d60d6def495d21149740ec263b5e018dc3ad3dd7040e8655069bbb50"
    },
    {
      "id": "TR-TONGUE-134",
      "text": "De drukke drukker drukt drie dikke druppels drukinkt op papier.",
