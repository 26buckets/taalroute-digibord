    },
    {
      "id": "TR-TONGUE-D240-A2-016",
      "text": "Ik pak mijn kersenpittenkussentje.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A2-017",
      "text": "Vera vult vijf volle vuilnisvaten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A2-018",
      "text": "De buur brengt bruine borden naar boven.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-062",
      "text": "Zes zachte zakken zitten stevig in dezelfde tas.",
      "status": "reuse_exact_text",
