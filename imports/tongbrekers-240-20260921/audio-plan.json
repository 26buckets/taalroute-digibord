      "sha256": "176d700408c004f849073512f5584fc67e60981bd8cd979b60709ec9d52a626d"
    },
    {
      "id": "TR-TONGUE-161",
      "text": "Netty legt het natte net net naast het nette net.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-161.mp3",
      "sha256": "4a071bec8e0a80cb4a76bc6251be4a298766f98f0a08e239cb0e5ebb11c558dd"
    },
    {
      "id": "TR-TONGUE-036",
      "text": "De koetsier poetst de koets van de postkoets met de poetsdoek.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-036.mp3",
      "sha256": "bd2071f3e5c457b6927db0ad2b41cad7160b7636a47ffbbf3970665bf0aabeca"
    },
    {
      "id": "TR-TONGUE-030",
      "text": "Als apen elkaar naapen, apen apen apen na.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-030.mp3",
      "sha256": "351344fe12c76ccd5a74a3baae1f77db28183e43b6e7ba1695bf5d0d2d97ec69"
    },
    {
      "id": "TR-TONGUE-014",
      "text": "Jeukt jouw jeukende neus ook zo als mijn jeukende neus jeukt?",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-014.mp3",
      "sha256": "54f7e7e8582f98549020607e08fd562b9ccd448ae2d078e67ea81fd9b2040bbd"
    },
    {
      "id": "TR-TONGUE-017",
      "text": "Als jouw teckel mijn teckel tackelt, tackelt mijn teckel jouw teckel terug.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-017.mp3",
      "sha256": "750fd8a788fe5fff4d6ca1e782f2b47aa8bacce71f7c68720dd2450a87c8a254"
    },
    {
      "id": "TR-TONGUE-005",
      "text": "Voor was was was was was is.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-005.mp3",
      "sha256": "4485b52c2f76e1f4fbbbf142e757fcf5d467cced254c20bf9dc27248cdd67bdc"
    },
    {
      "id": "TR-TONGUE-001",
      "text": "Zeven schone Schotse schaatsers schaatsen een scheve schaats in Scheveningen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-001.mp3",
      "sha256": "8364e507990e7dfeed11326e655b56ea9b457fb6dc241974b6723ddbbf048c36"
    },
    {
      "id": "TR-TONGUE-010",
      "text": "Pieter Peeters plant petieterige peterselieplantjes in pimpelpaarse peperpotjes.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-010.mp3",
      "sha256": "f8f55a6a3eb8af9d2fb8db0e121291ddaa173f6636e3dbc55bd435ca9ca169a3"
    },
    {
      "id": "TR-TONGUE-020",
      "text": "Ping en Pong speelden pingpong. Ping pingpongde de pingpongbal naar Pong en Pong pingpongde de pingpongbal naar Ping.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-020.mp3",
      "sha256": "a220feb306408980452917abb930116f15b79c5e82b05c8d480799d73ea687e8"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-004",
      "text": "Als een potvis in de pispot pist, heb je een pispot vol potvispis.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-005",
      "text": "Mijn zeven zeven zeven zeven keer beter dan jouw zeven zeven.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-007",
      "text": "De knecht van Klaas de knappe kapper knipt en kapt nog knapper dan Klaas de knappe kapper knippen en kappen kan.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-007.mp3",
      "sha256": "c3e4585134952f7ce88445792bfda86ea6fc0fcd0a1d151f08494b1dc4be914e"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-007",
      "text": "Wie weet waar Willem Wevers witte wollen winterwanten werkelijk waren?",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-033",
      "text": "Leentje leerde Lotje lopen langs de lange lindelaan, maar toen Lotje niet wou lopen, liet Leentje Lotje staan.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-033.mp3",
      "sha256": "c5579687048986f755d98783ace1f060a327fadb17d632e63c95e70894c95eb6"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-009",
      "text": "Als achter vliegen vliegen vliegen, vliegen vliegen vliegen achterna.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-043",
      "text": "De herbergier van de herberg hier herbergt hier de herbergier van de herberg daar.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-043.mp3",
      "sha256": "5cbce89e293fce9eb23764afb5e99768ee3272a8a73727ed7b842d1141036e4d"
    },
    {
      "id": "TR-TONGUE-048",
      "text": "Zeven zware zwemmers zwemmen zwoele zomerse zondagen zomaar zonder zwembroek in de zwarte zee.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-048.mp3",
      "sha256": "67464ed4623dcdf4d41f06b6f19e921cd46b114cd0f2fbc84d7f24dea66fcb0f"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-012",
      "text": "Frans zei tegen Frans in het Frans: is Frans in het Frans Frans? Nee, Frans in het Frans is François.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-013",
      "text": "Als kakkerlakken in kattenbakken kakken, kun je kattenbakken vol kakkerlakkak pakken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-014",
      "text": "Ik denk dat dat dat dat daar staat, dat dat dat moet zijn.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-015",
      "text": "Wie een scheur scheef dichtnaait, naait de scheve scheur scheef dicht.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-016",
      "text": "De stratenmaker straat de straat, maar straat de straat steeds schever.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-017",
      "text": "Een kromme kurkentrekker trekt de kurk krom uit de kruik.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-018",
      "text": "De kleermaker knipt kleine knoopsgaten in kleren met knellende knopen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-019",
      "text": "In de drukke drukkerij drukt Dries drie proefdrukken met drukfouten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-020",
      "text": "Wie de klos losklopt, klopt de losse klos los van de plank.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-021",
      "text": "De buurvrouw breit breed, maar haar broer breit bredere breisels.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-022",
      "text": "De klep van de klepkar klapt dicht tegen de klepperende klapdeur.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-023",
      "text": "De trein trekt traag drie treinstellen door de treinwasstraat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-024",
      "text": "De kok klopt klontjes uit de saus, maar de saus klontert koppig door.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-025",
      "text": "Als de slotenmaker het slot sluit, sluit het slot de slotenmaker buiten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-026",
      "text": "De schilder schuurt de schuurdeur schoon voordat hij de schuurdeur schildert.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-027",
      "text": "De blikken deksels blinken tussen de blikken met blikjes.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-028",
      "text": "De tandarts telt tien tanden, maar telt twee tanden twee keer.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-029",
      "text": "De verhuizer verhuist de vriezer voorbij de vastgelopen verhuiswagen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-030",
      "text": "Wie zijn sokken in zakken stopt, stopt soms zakken tussen zijn sokken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-031",
      "text": "De broodrooster roostert droog brood, maar droog brood roostert droger.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-032",
      "text": "Als de schroevendraaier de schroef scheef draait, draait de scheve schroef scheef terug.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-033",
      "text": "Pakt de pakjespakker het pakket verkeerd in, dan pakt de pakketbezorger het pakket weer uit.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-034",
      "text": "De stadsdichter dicht over dichte stadspoorten, maar dicht de dichtstbijzijnde poort niet dicht.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-035",
      "text": "Wie een scheepsschroef schoon schrobt, schrobt scheepsschroefschilfers uit de schroefschacht.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-036",
      "text": "De knoflookkweker knoopt knoflookstrengen vast aan knoestige knoflookrekken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-037",
      "text": "Wie een kromme kromming recht probeert te trekken, trekt de rechte kant soms krommer dan de kromming.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-038",
      "text": "Wie plakband op plakband plakt, plakt het plakband vast aan het plakband dat al geplakt zat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-039",
      "text": "De heggenschaar snijdt scherper sinds de scherenslijper de scheve schaar langs zijn slijpsteen schoof.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-040",
      "text": "De klapstoel klapt dicht zodra de klapstoelverkoper de dichtgeklapte klapstoel openklapt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-041",
      "text": "De sluiswachter sluit de sluis zodra de laatste slome sleepboot langs de sluisdeur schuift.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-042",
      "text": "De schilder schildert de schilder die de schilder schildert, terwijl die schilder hem terugschildert.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-043",
      "text": "De letterzetter zet de letters recht, maar zet de rechtgezette letters telkens in de verkeerde lettervolgorde.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-044",
      "text": "Hoe strakker de strikkenstrikker de strikken strikt, hoe stroever de strakgestrikte strikken straks schuiven.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-045",
      "text": "De trompettist trachtte drie treurige trompettrillers te trillen, tot de trombonist drie trillers terugtrilde.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-046",
      "text": "Niet de knoop die de knoper knoopte, maar de knoop die hij daarna knoopte, knoopte de knopenstreng vast.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-047",
      "text": "Schat de schade aan de schaatsen, maar schat de schade aan de schaatsenslijper niet te schraal.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-048",
      "text": "Waar de warrelwind wollige wolken wegwervelt, wapperen verweerde wimpels wild.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-049",
      "text": "De prins prees precies de preischotel die de preikok presenteerde.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-050",
      "text": "De poelier plukte plots pluizige pluimen uit een pluimveekussen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-051",
      "text": "Hoe langer de lome lepelaar langs de leliebladeren laveerde, hoe losser de leliebladeren lagen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-052",
      "text": "Proef de prikkelende pruimenpuree, prevelde de prinses.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-053",
      "text": "De trage truffelzoeker struikelde tussen drie struikwortels en trof drie vertrapte truffels.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-054",
      "text": "Voor de voorste voorzetwand stond voorheen een voorzetwand die vroeger voorste voorzetwand was.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-055",
      "text": "De zeepzieder zag zes zussen zorgvuldig zeezout zeven.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-056",
      "text": "De scharenslijper schatte scherp hoeveel scharen scherper sneden na het slijpen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-057",
      "text": "Wie het weerbericht weer weerlegt met het weer van gisteren, weerlegt weer wat het weerbericht voorspelde.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-058",
      "text": "De postzegelplakker plakte postzegels op postzegelpakketten, terwijl de verzamelaar ze er prompt weer af pulkte.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-059",
      "text": "De scheepsschroefschacht schuurde schuin langs het scheepsschot, zodat de scheepsschadecontroleur schrok.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-B1-C2-060",
      "text": "Wie twijfelt of de twijfelaar twijfelt aan zijn twijfel, twijfelt misschien aan de twijfel waaraan hij zelf niet meer twijfelt.",
      "status": "recording_required"
    }
  ]
}
