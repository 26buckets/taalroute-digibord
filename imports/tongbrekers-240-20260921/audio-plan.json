  "items": [
    {
      "id": "TR-TONGUE-049",
      "text": "Pim pakt papier.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-049.mp3",
      "sha256": "d29e35ad7be222bdd65f5df136b8d4a079f180baf42c297c62d4c42c99d3a24d"
    },
    {
      "id": "TR-TONGUE-105",
      "text": "Nat net, net nat.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-105.mp3",
      "sha256": "d0f154c82c21c80099feb9ad6e12fcfc25b8fccd13bfe6499a655997323fb525"
    },
    {
      "id": "TR-TONGUE-D240-A0-003",
      "text": "Pak pap, pak sap.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-004",
      "text": "Kop, kip, kop, kip.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-005",
      "text": "Kan in pan, pan in kan.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-006",
      "text": "Pak de pan, pak de pen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-007",
      "text": "Vis of vies, vies of vis.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-008",
      "text": "Baan, been, boon, been, baan.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-009",
      "text": "Bep belt Bob.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-010",
      "text": "Piet pakt patat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-011",
      "text": "Saar snijdt sla.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-012",
      "text": "Sien ziet zee.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-013",
      "text": "Wim wast wol.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-014",
      "text": "Jas in tas, tas met jas.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-015",
      "text": "Bas wast was.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-016",
      "text": "Kop op kop op kop.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-017",
      "text": "Pak, pik, pak, pik.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-018",
      "text": "Tik op tak, tak op tik.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-019",
      "text": "Pap plakt, pak plakt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-020",
      "text": "Bus bij bos, bos bij bus.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-021",
      "text": "Natte noten, nette noten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-022",
      "text": "Twee tenen tikken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-023",
      "text": "Zes zakken, zes sokken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-024",
      "text": "Volle vellen vallen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-025",
      "text": "Losse lussen, losse lassen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-026",
      "text": "Rode rits, rare rits.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-027",
      "text": "Kom maar, kam maar.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-028",
      "text": "Pak de kop, pak de kan.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-029",
      "text": "Dikke sokken zakken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-030",
      "text": "Rode rollen rollen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-031",
      "text": "Kat tikt tak.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-032",
      "text": "Kip pikt pit.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-033",
      "text": "Kees kiest kaas.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-034",
      "text": "Koos kiest koek.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-035",
      "text": "Fien vindt vis.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-036",
      "text": "Tien tenen tikken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-037",
      "text": "Zes zussen zingen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-038",
      "text": "Zeven zussen zoeken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-039",
      "text": "Kleine klokken klinken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-040",
      "text": "Platte planten plakken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-124",
      "text": "Lange lepels liggen links.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-124.mp3",
      "sha256": "bc2709dfab5b67569ed2de8c55a234157923af2c1abb9514b712f492da72b2b5"
    },
    {
      "id": "TR-TONGUE-D240-A0-042",
      "text": "Schone schoenen schuiven.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-018",
      "text": "Drie droge doeken.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-018.mp3",
      "sha256": "6192e10cfcf189d4ae6f17819022e0520121981919b79bdbfd3b33fac2142c39"
    },
    {
      "id": "TR-TONGUE-D240-A0-044",
      "text": "Twee trage treinen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-045",
      "text": "Vier vieze vazen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-046",
      "text": "Vijf volle vellen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-047",
      "text": "Zwarte zak, zachte zak.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-048",
      "text": "Dikke tak, dunne tak.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-107",
      "text": "Rood haar, raar haar.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-107.mp3",
      "sha256": "c48dbf3006932b67825da8f93b6ff0d605ecc691d06995c9ef691663e20ff7c0"
    },
    {
      "id": "TR-TONGUE-D240-A0-050",
      "text": "Kat krabt krat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-051",
      "text": "Krab krabt krat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-052",
      "text": "Broer brengt brood.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-053",
      "text": "Blauwe bril, bruine bril.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-054",
      "text": "Rode roos, rare roos.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-055",
      "text": "Korte krul, kromme krul.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-056",
      "text": "Strakke straat, stroeve straat.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-057",
      "text": "Knappe knieën knikken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-058",
      "text": "Flinke fles valt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-059",
      "text": "Slappe sla slaapt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A0-060",
      "text": "Drie dikke druppels.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-004",
      "text": "De prins spreekt slecht Spaans.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-004.mp3",
      "sha256": "7f30851cfbba1c1a61ce77f8e9d7ae35e54030a3a64b7e93979785dc9b08370a"
    },
    {
      "id": "TR-TONGUE-D240-A1-002",
      "text": "Boterklontje, boterklontje, boterklontje.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-003",
      "text": "Die dikke domoren drammen door.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-013",
      "text": "De kat krabt de krullen van de trap.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-013.mp3",
      "sha256": "b794fb3bdcb2112e734c369c7909572b0049adb0860a93d908a38b14397e8822"
    },
    {
      "id": "TR-TONGUE-016",
      "text": "Frits vindt visfrietjes vreselijk vies.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-016.mp3",
      "sha256": "a0b81350684dbf47c03c8c331982d2ac63067d10fdb818f0972d081c560ed90c"
    },
    {
      "id": "TR-TONGUE-022",
      "text": "Ik schrijf scheef in mijn schrift.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-022.mp3",
      "sha256": "25ee063353024ae9f1ae1d495d9ac79330f9512ac4109177db7e3bb55ef27906"
    },
    {
      "id": "TR-TONGUE-D240-A1-007",
      "text": "Bakker Bas bakt bolle broodjes bruin.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-027",
      "text": "Bedek het bed met het dekbed.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-027.mp3",
      "sha256": "f35967556f4a3e91c60d0ba224f0f3f7b39e1ba1fe1b2c94bc9ce49c2dcb8d23"
    },
    {
      "id": "TR-TONGUE-D240-A1-009",
      "text": "Papa pakt de platte bakpan.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-044",
      "text": "Drie dove domme dromedarissen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-044.mp3",
      "sha256": "024c062bb4f9c4446cda8cd360d68db6dce09c58c459edd802e7f04acb7ebd2e"
    },
    {
      "id": "TR-TONGUE-055",
      "text": "Koen koopt koek, maar de koek kruimelt.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-055.mp3",
      "sha256": "e48ca335f09ead30ad318db6748190d3af6f14c5136fdd1723f683971f0ceb36"
    },
    {
      "id": "TR-TONGUE-057",
      "text": "In de stille straat staan twee stoelen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-057.mp3",
      "sha256": "11d4e3b1194ddfd6bc1c5e987d966adcd606c5e5c3689c1d7c09d283b338c7da"
    },
    {
      "id": "TR-TONGUE-061",
      "text": "Frans fietst vroeg naar de fruitmarkt.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-061.mp3",
      "sha256": "8d6749c052732c5e63a018ca2cd0832c4e57fbc899dbdba6ab215b9eb7291d02"
    },
    {
      "id": "TR-TONGUE-089",
      "text": "Pak de kop, pak de kan, pak de pan.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-089.mp3",
      "sha256": "36dd083ca10041ff59f13b16578445c3f47d8474fb5df336e9ee6cc242d2d09a"
    },
    {
      "id": "TR-TONGUE-092",
      "text": "Twee katten tikken tegen tien takken.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-092.mp3",
      "sha256": "a9bb84f0ca4642628a0b87df32873b8071a603de935f78c7265fea9773493a23"
    },
    {
      "id": "TR-TONGUE-094",
      "text": "De kok kookt kool in een kleine kookpan.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-094.mp3",
      "sha256": "1eeb55bbc0311602c131b2dac0ef2c8d036be11d5eedff755f2d0396bc7b5ab1"
    },
    {
      "id": "TR-TONGUE-095",
      "text": "Zes zussen zoeken zeven sokken.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-095.mp3",
      "sha256": "5c74f60ce967bb4a55a457c2a9061427dfcf57de27df348e0a053fb49852a624"
    },
    {
      "id": "TR-TONGUE-096",
      "text": "Knappe kappers knippen korte krullen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-096.mp3",
      "sha256": "2d1f4a9a9554f6b9f38adc4854b473adef577423d210fc12f050bee0e988c3eb"
    },
    {
      "id": "TR-TONGUE-097",
      "text": "Kees kiest kaas, Koos kiest koek.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-097.mp3",
      "sha256": "3311ed292ce4a36da30ddd8a7859450a0479e8147358f184751ab9aaae1b635b"
    },
    {
      "id": "TR-TONGUE-098",
      "text": "Piet poetst de pot, de pot poetst Piet.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-098.mp3",
      "sha256": "4df638e640085c22d33cc06cf97b0bc987dd90108efcfdc70ecbcfdae407d124"
    },
    {
      "id": "TR-TONGUE-099",
      "text": "Bert botst, Bart bukt, Bert bukt, Bart botst.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-099.mp3",
      "sha256": "93829b9f21b2e7966d2392295804d656a944e6e16bef3aa395046789992b6b8a"
    },
    {
      "id": "TR-TONGUE-100",
      "text": "Grote groene glazen glimmen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-100.mp3",
      "sha256": "4bb72b968185c61d4d75e5ad74bb8bbd5362ef24489bc98c2beb38dc841f17bc"
    },
    {
      "id": "TR-TONGUE-101",
      "text": "Vijf vuile vorken vallen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-101.mp3",
      "sha256": "2e273ca355122d8c4b95bc2d6df4cf5e63f80fddbad5a2fa86e519cc198c713e"
    },
    {
      "id": "TR-TONGUE-102",
      "text": "Vis in de fles, vlees in de tas.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-102.mp3",
      "sha256": "1fc829c8e7a7c2d5a98455871f89b49dbb614a53200c260253b0e74a797aeaa9"
    },
    {
      "id": "TR-TONGUE-103",
      "text": "De tas past pas naast de kast.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-103.mp3",
      "sha256": "bce5c6a0bb917deefd449fb7a345b89f7bb78b1f29ee081cf22974326520d102"
    },
    {
      "id": "TR-TONGUE-104",
      "text": "Sam wast zes vieze vazen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-104.mp3",
      "sha256": "e8d3181fc40f3334e714be3e9ecd8d198c3f7d6a4bf52b2c51a6534fad2897f3"
    },
    {
      "id": "TR-TONGUE-106",
      "text": "Tante Tine telt tien tanden.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-106.mp3",
      "sha256": "fad36c8bd02c064f13298fa2242906e766f94772e4f335b792ded8ce449c1bb9"
    },
    {
      "id": "TR-TONGUE-109",
      "text": "Negen natte neuzen niezen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-109.mp3",
      "sha256": "aad6150f749d7b575904eea4b24b4e92f4cec37208481e8e89fe90e088feef53"
    },
    {
      "id": "TR-TONGUE-111",
      "text": "Zeven zakken zout zakken weg.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-111.mp3",
      "sha256": "6636dc968b248d138aa0a8f9dac6e622dc2a0cb9d90bc6749366f009d0d6a02c"
    },
    {
      "id": "TR-TONGUE-112",
      "text": "Zes messen missen één mes.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-112.mp3",
      "sha256": "096b6618ddba665836177e1a7f11f47353b588f3b619540bf87d8102bf265420"
    },
    {
      "id": "TR-TONGUE-115",
      "text": "De kip pikt, de kikker kijkt.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-115.mp3",
      "sha256": "b01bb75bb6d58afefe2bb95eb9ec7aac1bb3e391bd0f95f2e20c8bf3654de08b"
    },
    {
      "id": "TR-TONGUE-117",
      "text": "Drie trage treinen trillen.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-117.mp3",
      "sha256": "67dfcd775766668aeee269626a977a824ab3c8fc6e1dfc47fcf1e457cf670456"
    },
    {
      "id": "TR-TONGUE-119",
      "text": "Een paar paarse paarden.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-119.mp3",
      "sha256": "a513129804a036323dedd81dfb0e871c0627407a1b3a4ccc17a7eb2083512245"
    },
    {
      "id": "TR-TONGUE-122",
      "text": "De draad draait drie keer.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-122.mp3",
      "sha256": "8979233bbf4d0c5d935a94c6b6154199a2a23c0b181abeca650bf7d05ed9a739"
    },
    {
      "id": "TR-TONGUE-D240-A1-035",
      "text": "Gijs giet geel sap.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-036",
      "text": "Schoon schort, scheef schort.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-037",
      "text": "De slome slak sleept sla.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-038",
      "text": "Bram brengt breed brood.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-039",
      "text": "Fien vouwt vijf vellen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-040",
      "text": "Tom trekt twee tassen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-041",
      "text": "Saar schuift zes schalen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-042",
      "text": "Karel kraakt krokante crackers.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-043",
      "text": "De kleine kraan kraakt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-044",
      "text": "Roos rolt rode rollen.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-045",
      "text": "De grijze gans graast graag.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-046",
      "text": "Drie broers brengen brood.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-047",
      "text": "Vera veegt vijf vieze vegen weg.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-048",
      "text": "De post past pas in de postbus.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-049",
      "text": "Een platte plaat plakt.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-050",
      "text": "De blauwe blouse blijft blauw.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-051",
      "text": "Kleine krabben kruipen krom.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-052",
      "text": "Vier frisse frieten frituren.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-053",
      "text": "De snelle slager snijdt sla.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-054",
      "text": "Zes zachte zolen zakken.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-055",
      "text": "De groene groenteboer grijnst.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-056",
      "text": "Truus trekt drie truien.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-057",
      "text": "De brede brug breekt bijna.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-058",
      "text": "Twee stoere stieren staren.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-059",
      "text": "De schoen schuift schuin.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A1-060",
      "text": "Drie glazen glijden glad.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-002",
      "text": "Ruud Rups raspt rap rode ronde radijsjes.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-002.mp3",
      "sha256": "272a3599e6dcefe844713157c6b6ba95e84654096bf180e53ddc4b20c42448ff"
    },
    {
      "id": "TR-TONGUE-D240-A2-002",
      "text": "Wat Wil wil, wil Wil wel weten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-009",
      "text": "Een pet met een platte klep is een platte kleppet.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-009.mp3",
      "sha256": "7101966cdcfadedfc4ecbf16a3657394015b34569281ff7c99f2108762198964"
    },
    {
      "id": "TR-TONGUE-011",
      "text": "Moeder sneed zeven scheve sneden brood.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-011.mp3",
      "sha256": "4d638c5c1397298233eec6d04ac83b50c3a54e8d77ed90edbdfa4c6a68a19d9c"
    },
    {
      "id": "TR-TONGUE-012",
      "text": "Max mixt de whisky met de whiskymixer.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-012.mp3",
      "sha256": "eaa2fc0cb221c5cbce8b10e21e4c0808ca22c5fd21ff1871b9c4fc0d2240caa9"
    },
    {
      "id": "TR-TONGUE-019",
      "text": "Ik zag haar haar kammen met haar haarkam.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-019.mp3",
      "sha256": "e764708c9ce6d8d6e9e44d50ef92add157e3698ed2138422c290cfb4551c1ef4"
    },
    {
      "id": "TR-TONGUE-021",
      "text": "De knecht snijdt recht en de meid snijdt scheef.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-021.mp3",
      "sha256": "76c27be44d2e70a98ae2265529f2c5d11afbf869008b74ec944773062799cd24"
    },
    {
      "id": "TR-TONGUE-D240-A2-008",
      "text": "Klara knipt de krullenkop kaal.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-D240-A2-009",
      "text": "Zij zei dat zij zei dat zij wat zei.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-025",
      "text": "Die schaar knipt knap stroef.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-025.mp3",
      "sha256": "7afb59d0a501027b492edfea15451a6ba0cc6cea121bdde138f28215beb647e7"
    },
    {
      "id": "TR-TONGUE-028",
      "text": "Duizend dames drinken dagelijks druivensap.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-028.mp3",
      "sha256": "a7ea1e1ed147111dc95bfea98066eb60a1dda6af6833d5eedcd14881acb63148"
    },
    {
      "id": "TR-TONGUE-032",
      "text": "De kapster kapt de krullenbol op de kruk.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-032.mp3",
      "sha256": "ab82ac23c61051e938cc7752cf52c7286a88544af3e9951110b80d9a2ea5a65c"
    },
    {
      "id": "TR-TONGUE-D240-A2-013",
      "text": "Thijs snijdt de schijfjes steeds scheef.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-035",
      "text": "De poes kotst in de postzak.",
      "status": "reuse_exact_text",
