    },
    {
      "id": "TR-TONGUE-D240-A2-022",
      "text": "Bram brengt bruine borden binnen, de brede bak blijft buiten.",
      "status": "recording_required"
    },
    {
      "id": "TR-TONGUE-126",
      "text": "De schipper schuift de scheve schotel achter de schone schuur.",
