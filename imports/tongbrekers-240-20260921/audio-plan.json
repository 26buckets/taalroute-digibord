      "sha256": "3fab9e1dbe93d550bd509384c5e268a552f7364fbb38c5fd4b55a521116ce3a0"
    },
    {
      "id": "TR-TONGUE-037",
      "text": "Ik bak een plak bakbloedworst.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-037.mp3",
