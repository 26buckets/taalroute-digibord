      "sha256": "cf057bde7bad3da4e50acd1c19a9c90143cc591efdc4cccec91d61fc6b54a227"
    },
    {
      "id": "TR-TONGUE-148",
      "text": "Willem wast witte was, terwijl Wilma wollen wanten wast.",
      "status": "reuse_exact_text",
