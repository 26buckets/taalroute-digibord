    },
    {
      "id": "TR-TONGUE-128",
      "text": "De postbode stopt de post pas in de pas geverfde postbus.",
      "status": "reuse_exact_text",
      "src": "assets/audio/tongbrekers/tr-tongue-128.mp3",
      "sha256": "2e9db06c508b28c84cd5095f4b7f21df6aec36d2bc0d50a8dd4bf31f69b57921"
    },
    {
      "id": "TR-TONGUE-129",
      "text": "De kapper knipt krullen, maar de krullen klitten aan zijn kleren.",
